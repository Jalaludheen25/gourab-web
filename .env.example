# Public site URL — used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.gtsllcuae.com

# Contact form delivery: any endpoint that accepts a JSON POST
# (e.g. https://formspree.io/f/xxxxxxx, a Make/Zapier webhook, or your own API).
# Without it, production returns 503 and the form offers a pre-filled email instead.
CONTACT_FORM_ENDPOINT=
